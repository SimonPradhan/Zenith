    <item android:gravity="bottom|end" android:width="28dp" android:height="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#B9CDB2" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#F6FAF1" />
        </shape>
    </item>
</layer-list>
