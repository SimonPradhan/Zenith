<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#18181B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ZENITH"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Refresh"
            android:textColor="#C4B5FD"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Your upcoming tasks"
        android:textColor="#FAFAFA"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="top"
        android:maxLines="5"
        android:text="Open Zenith to sign in and load tasks."
        android:textColor="#D4D4D8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/quick_note_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#8B5CF6"
        android:gravity="center"
        android:padding="10dp"
        android:text="+ Quick note"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
