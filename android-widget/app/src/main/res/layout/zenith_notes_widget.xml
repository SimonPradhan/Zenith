<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/note_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/sticky_note_background">

        <TextView
            android:id="@+id/note_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Fix FIX FIX!!!!"
            android:textColor="#273128"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/note_card_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="top"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:text="Ideas, reminders, and little things worth remembering."
            android:textColor="#3E4A3F"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#3B8C6C30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/note_updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Updated today"
                android:textColor="#66776A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notes_refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="↻"
                android:textColor="#66776A"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/note_add_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/sticky_note_add"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="normal" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/sticky_note_pin"
        android:gravity="center"
        android:text="•"
        android:textColor="#E7DFFF"
        android:textSize="24sp"
        android:textStyle="bold" />
</FrameLayout>
